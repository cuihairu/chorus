<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Api.CommonProtos" Version="2.15.0" />
    <PackageReference Include="Google.Protobuf" Version="3.35.0" />
    <PackageReference Include="Grpc.Core.Api" Version="2.83.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.0" />
    <Protobuf Include="Protos/m0.proto" GrpcServices="Both" />
    <Protobuf Include="Protos/m1.proto" GrpcServices="Both" />
    <Protobuf Include="Protos/m2.proto" GrpcServices="Both" />
    <Protobuf Include="Protos/m2.round.proto" GrpcServices="Both" />
    <Protobuf Include="Protos/m2.frame.proto" GrpcServices="Both" />
    <Protobuf Include="Protos/m2.settle.proto" GrpcServices="Both" />
    <Protobuf Include="Protos/m2.board.proto" GrpcServices="Both" />
    <Protobuf Include="Protos/m2.sync.proto" GrpcServices="Both" />
    <Protobuf Include="Protos/m2.host.proto" GrpcServices="Both" />
    <Protobuf Include="Protos/m2.retention.proto" GrpcServices="Both" />
    <Protobuf Include="Protos/m3.proto" GrpcServices="Both" />
    <Protobuf Include="Protos/m4.proto" GrpcServices="Both" />
  </ItemGroup>
  <PropertyGroup>
    <!-- The google.api well-knowns the browser Admin contract's http annotations reference
         (FIX-WEB-01): the HttpRule messages and the extension come from the
         Google.Api.CommonProtos package (the same googleapis sources, precompiled), so
         `import "google/api/annotations.proto"` in m3.proto resolves against the package's
         content/protos include path instead of an in-tree copy. (The JsonTranscoding the
         browser face needs pulls the same package in transitively — one source, no
         duplicate Google.Api.HttpRule type across assemblies.) -->
    <IncludeGoogleApiCommonProtos>true</IncludeGoogleApiCommonProtos>
  </PropertyGroup>
</Project>
