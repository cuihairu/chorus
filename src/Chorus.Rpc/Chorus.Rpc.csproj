<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.35.0" />
    <PackageReference Include="Grpc.Core.Api" Version="2.83.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.0" />
    <Protobuf Include="Protos/m0.proto" GrpcServices="Both" />
    <Protobuf Include="Protos/m1.proto" GrpcServices="Both" />
    <Protobuf Include="Protos/m2.proto" GrpcServices="Both" />
    <Protobuf Include="Protos/m3.proto" GrpcServices="Both" />
    <Protobuf Include="Protos/m4.proto" GrpcServices="Both" />
    <!-- The google.api well-knowns the browser Admin contract's http annotations reference
         (FIX-WEB-01). No services; they only carry the HttpRule messages and the extension. -->
    <Protobuf Include="Protos/google/api/http.proto" GrpcServices="None" />
    <Protobuf Include="Protos/google/api/annotations.proto" GrpcServices="None" />
  </ItemGroup>
</Project>
