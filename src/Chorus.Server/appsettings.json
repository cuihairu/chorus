{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Ingress": {
    "DedupTtlSeconds": 600,
    "FactionRules": {
      "CommentKeywords": {
        "#red": "red",
        "#blue": "blue"
      },
      "GiftIds": {
        "gift_red": "red",
        "gift_blue": "blue"
      }
    }
  },
  "AllowedHosts": "*"
}
