{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Ingress": {
    "DedupTtlSeconds": 600,
    "FactionRules": {
      "CommentKeywords": {
        "#red": "red",
        "#blue": "blue"
      },
      "GiftIds": {
        "gift_red": "red",
        "gift_blue": "blue"
      }
    }
  },
  "Session": {
    "TickDurationMs": 66,
    "InputDelayTicks": 2,
    "SnapshotEveryTicks": 1,
    "MaxEventsPerTick": 200,
    "MaxLagTicks": 50,
    "ResyncCooldownMs": 2000,
    "MaxPendingEvents": 8000,
    "EventEnqueueMaxWaitMs": 50,
    "TickTimeoutMs": 250,
    "MaxSessions": 200,
    "IdleEvictAfterMs": 600000,
    "MaxSnapshotBytes": 1048576
  },
  "AllowedHosts": "*"
}
