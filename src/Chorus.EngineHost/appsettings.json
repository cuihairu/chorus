{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Ipc": {
    "Transport": "Auto",
    "UnixSocketDir": "/tmp/chorus",
    "NamedPipePrefix": "chorus",
    "TcpHost": "127.0.0.1",
    "TcpGatewayToEnginePort": 27500,
    "TcpEngineToGatewayPort": 27501,
    "HttpGatewayToEngineUrl": "http://127.0.0.1:27600/gw-to-eng/",
    "HttpEngineToGatewayUrl": "http://127.0.0.1:27601/eng-to-gw/"
  },
  "Session": {
    "TickDurationMs": 100,
    "InputDelayTicks": 2,
    "SnapshotEveryTicks": 1,
    "MaxEventsPerTick": 200,
    "MaxLagTicks": 50,
    "ResyncCooldownMs": 2000
  },
  "AllowedHosts": "*"
}
