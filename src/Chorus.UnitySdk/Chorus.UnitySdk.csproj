<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The Unity floor (FIX-U3D-01): Douyin's LiveOpenSDK requires Unity 2020+ LTS,
         which speaks C# 8 and loads netstandard2.1 assemblies. LangVersion pins the
         floor at build time — a newer language feature fails this compile, not a
         streamer's Unity import. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- The leaf contract (FIX-U3D-02): no Chorus references. Every wire shape is
       restated platform-neutrally and the parity tests pin it against the server's
       contract, so the Unity package never drags the server stack into a game. -->

  <!-- Samples~ ships as source a game imports (Unity's import-on-demand folder); it
       never compiles into the SDK assembly. The full-loop sample proves itself in the
       test project, which link-compiles the same file (FIX-U3D-15). -->
  <ItemGroup>
    <Compile Remove="Samples~/**/*.cs" />
  </ItemGroup>

</Project>
