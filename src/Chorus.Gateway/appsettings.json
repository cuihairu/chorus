{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Ingress": {
    "DedupTtlSeconds": 600,
    "FactionRules": {
      "CommentKeywords": {
        "#red": "red",
        "#blue": "blue"
      },
      "GiftIds": {
        "gift_red": "red",
        "gift_blue": "blue"
      }
    }
  },
  "Session": {
    "TickDurationMs": 66,
    "InputDelayTicks": 2,
    "SnapshotEveryTicks": 1,
    "MaxPendingEvents": 8000,
    "EventEnqueueMaxWaitMs": 50,
    "TickTimeoutMs": 250,
    "MaxSessions": 200,
    "IdleEvictAfterMs": 600000,
    "MaxSnapshotBytes": 1048576
  },
  "Ipc": {
    "Transport": "Auto",
    "UnixSocketDir": "/tmp/chorus",
    "NamedPipePrefix": "chorus",
    "TcpHost": "127.0.0.1",
    "TcpGatewayToEnginePort": 27500,
    "TcpEngineToGatewayPort": 27501,
    "HttpGatewayToEngineUrl": "http://127.0.0.1:27600/gw-to-eng/",
    "HttpEngineToGatewayUrl": "http://127.0.0.1:27601/eng-to-gw/"
  },
  "AllowedHosts": "*"
}
